Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files/directories directly; send API routes to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Prevent access to dotfiles if the server configuration exposes them.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
