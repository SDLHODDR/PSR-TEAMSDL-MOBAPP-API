APP_ENV=local
APP_DEBUG=true
APP_NAME="SDL PSR API"
APP_URL=http://localhost
LOG_PATH=storage/logs

# Oracle connection settings — replace placeholders; never commit real credentials.
ORACLE_USER=your_schema_username
ORACLE_PASSWORD=replace_with_real_password
# Examples: hostname:1521/service_name OR //hostname:1521/service_name
ORACLE_CONNECTION_STRING=//127.0.0.1:1521/ORCLPDB1
ORACLE_CHARSET=AL32UTF8
