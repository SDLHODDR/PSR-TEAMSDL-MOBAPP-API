# Use production outside a developer workstation. APP_DEBUG must remain false in production.
APP_ENV=production
APP_DEBUG=false
APP_NAME="SDL PSR API"
APP_URL=https://api.example.com
# Comma-separated exact origins; do not use * when bearer tokens are used.
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_PATH=C:/var/log/sdl-psr-api
REQUEST_MAX_BODY_BYTES=1048576
# Keep disabled unless this endpoint is private-network-only or separately protected.
APP_HEALTH_DB_ENABLED=false

# JWT-only initial release. Keep the private key outside public/.
JWT_PRIVATE_KEY_PATH=C:/secure/sdl-psr/jwt-private.pem
JWT_PUBLIC_KEY_PATH=C:/secure/sdl-psr/jwt-public.pem
JWT_ISSUER=sdl-psr-api
JWT_AUDIENCE=sdl-psr-mobile
JWT_CLOCK_SKEW_SECONDS=30

# Oracle connection settings — replace placeholders; never commit real credentials.
ORACLE_USER=your_schema_username
ORACLE_PASSWORD=replace_with_real_password
# Examples: hostname:1521/service_name OR //hostname:1521/service_name
ORACLE_CONNECTION_STRING=//db.example.internal:1521/PROD_SERVICE
ORACLE_CHARSET=AL32UTF8

# Consent OTP SMS gateway. Use separate credentials in each environment.
SMS_GATEWAY_URL=https://sms.cell24x7.com:1111/mspProducerM/sendSMS
SMS_GATEWAY_USERNAME=replace_with_gateway_username
SMS_GATEWAY_PASSWORD=replace_with_gateway_password
SMS_GATEWAY_SENDER=AyHelp
SMS_GATEWAY_CONSENT_TEMPLATE_ID=1007625915365393454
